# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
FLASK_ENV=development
COGNI_HOST=127.0.0.1
FLASK_DEBUG=0

# Authentication (use HTTPS and secure cookies when hosted)
COGNI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COGNI_COOKIE_SECURE=0
COGNI_DEV_OTP=0
# Development shortcuts (leave commented out; local-only and disabled by default)
# COGNI_DEV_LOGIN=1
# DEV_DEMO_PASSWORD=demo1234
# NEXT_PUBLIC_DEV_LOGIN=1
# Gmail address and app password; never commit actual credentials
SMTP_USER=
SMTP_PASS=
